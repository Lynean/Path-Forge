{
  "name": "@workspace/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx ./src/evals/run-suite.ts",
    "graph:code": "tsx ./src/code-graph/cli.ts",
    "graph:project": "tsx ./src/code-graph/project-cli.ts",
    "verify:code-graph": "tsx ./src/evals/verify-code-graph.ts",
    "verify:project-graph": "tsx ./src/evals/verify-project-graph.ts",
    "verify:graph-search": "tsx ./src/evals/verify-graph-search.ts",
    "benchmark:retrieval": "tsx ./src/evals/benchmark-retrieval.ts",
    "benchmark:debug-search": "tsx ./src/evals/benchmark-debug-search.ts",
    "eval:repair": "tsx ./src/evals/run-repair-loop-suite.ts",
    "eval:docker": "tsx ./src/evals/run-docker-suite.ts",
    "eval:docker:python": "tsx ./src/evals/run-python-docker-suite.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
