{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src --watch ../../lib --ext ts --exec \"pnpm run build && pnpm run start\"",
    "build": "node ./build.mjs",
    "start": "cross-env PORT=5000 node --enable-source-maps --env-file=../../.env ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent:verify-adapter": "tsx src/lib/agent/verify-legacy-adapter.ts",
    "agent:verify-harness": "tsx src/lib/agent/verify-harness-runtime.ts",
    "agent:verify-domain-tools": "tsx src/lib/agent/verify-domain-tools.ts",
    "agent:verify-persistence": "tsx src/lib/agent/verify-persistence.ts",
    "agent:verify-local-db": "tsx src/lib/agent/verify-local-db.ts",
    "agent:verify-real-folder": "tsx src/lib/agent/verify-real-folder.ts",
    "agent:verify-run-python": "tsx src/lib/wasm/verify-run-python.ts",
    "agent:verify-run-python-tool": "tsx src/lib/agent/tools/verify-run-python-tool.ts",
    "agent:verify-invalid-arg-recovery": "tsx src/lib/agent/verify-invalid-arg-recovery.ts",
    "agent:verify-propose-environment": "tsx src/lib/agent/tools/verify-propose-environment.ts",
    "agent:verify-custom-environment": "tsx src/lib/agent/verify-custom-environment.ts",
    "agent:verify-run-in-environment": "tsx src/lib/agent/tools/verify-run-in-environment.ts",
    "agent:verify-observation-compaction": "tsx src/lib/agent/verify-observation-compaction.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.31",
    "@clerk/shared": "^4.21.0",
    "@electric-sql/pglite": "^0.5.4",
    "@workspace/agent-runtime": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openrouter-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pyodide": "^314.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "cross-env": "^10.1.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
